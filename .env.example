# Copy to .env.local. From Supabase → Project Settings → API.
# The anon key is a public client key; security comes from Row Level Security (see supabase/schema.sql).
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: '/deskflow/' when deploying to https://<user>.github.io/deskflow/ (the CI workflow sets this).
# VITE_BASE_PATH=/
